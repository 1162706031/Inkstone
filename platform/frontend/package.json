{
  "name": "ai-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-typescript ../contracts/openapi.json -o src/api/generated/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "test": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.105.1",
    "antd": "6.6.8",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.0.10",
    "vitest": "5.0.5"
  }
}
