# 本机开发配置，模板见 ../infra/.env.example。API、Worker 和迁移命令均从 platform/backend 启动。
ENVIRONMENT=development
APP_ORIGIN=http://127.0.0.1:5174

# PostgreSQL 开发实例。密码填写原值；URL 中的特殊字符由后端编码。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ai_platform_dev
POSTGRES_USER=ai_dev
POSTGRES_PASSWORD=ai_dev_password

# Redis 开发实例。使用 requirepass 时账号是 default，使用 ACL 时填写实际用户名。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=default
REDIS_PASSWORD=8ab8ab0d15a4769bcce3ca04b3fb4812784777f28789de25
REDIS_PREFIX=ai-dev

# 托管服务、TLS 或已有部署可设置完整连接串；完整 URL 优先。
# DATABASE_URL=postgresql://user:encoded-password@db-host:5432/db-name?sslmode=verify-full
# CHECKPOINT_DATABASE_URL 默认沿用 DATABASE_URL；显式配置时须指向同一库。
# REDIS_URL=rediss://user:encoded-password@redis-host:6379/0

# 将下面的路径改为本机绝对路径。密钥文件为 32 个原始字节。
CREDENTIAL_KEY_FILE=C:/Users/11627/AppData/Local/ai-platform-dev/credential.key
CREDENTIAL_KEY_VERSION=v1
DELETION_ARCHIVE_PATH=C:/Users/11627/AppData/Local/ai-platform-dev/archive/deletions.sqlite3
CONTEXT_LIMIT_TOKENS=32768
# PRIVATE_MODEL_ALLOWLIST=
